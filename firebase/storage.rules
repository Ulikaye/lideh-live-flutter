rules_version = '2';

// Storage layout:
//   profile_pictures/{fileName}  — any signed-in user's own avatar
//   musician_media/{fileName}    — musician performance photos/clips
//   event_images/{fileName}      — organizer event cover images
//   blog_images/{fileName}       — admin-only, uploaded from the in-app
//                                  blog editor (see AdminBlogEditorScreen)
//
// Files are named with a generated UUID (see StorageService), so there
// is no per-owner subfolder to check ownership against on write; write
// access is instead gated by "any authenticated user of the right
// role," and deletion of a specific file is handled by the app calling
// deleteByUrl with the exact ref it uploaded. This trades fine-grained
// per-file ownership for simplicity — acceptable here because these
// are non-sensitive public-facing media assets, not private documents.

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isVideo() {
      return request.resource.contentType.matches('video/.*');
    }

    function underSizeLimit(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    // Cross-service lookup into Firestore to confirm the caller's
    // users/{uid}.user_type is 'admin' — mirrors the redirect guard
    // already enforced client-side in app_router.dart for /admin
    // routes, so the same rule is now enforced server-side too.
    function isAdmin() {
      return isSignedIn() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.user_type == 'admin';
    }

    match /profile_pictures/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && isImage() && underSizeLimit(5);
    }

    match /musician_media/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && (isImage() || isVideo()) && underSizeLimit(50);
    }

    match /event_images/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && isImage() && underSizeLimit(5);
    }

    match /blog_images/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && underSizeLimit(5);
    }

    match /ecard_media/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && isImage() && underSizeLimit(5);
    }
  }
}
