rules_version = '2';

// Security model summary:
// - users/{uid}, musicians/{uid}, organizers/{uid} are all keyed by the
//   Firebase Auth uid, so "own document" checks are always a direct
//   doc-id comparison against request.auth.uid — no extra lookups.
// - skills/ and blogCategories/ are admin-managed reference data:
//   public read, no client write.
// - bookings/ is the most sensitive collection: only the two parties on
//   a booking (the musician and the organizer who created it) may read
//   it, and status transitions are constrained to the party allowed to
//   make them (organizer creates/cancels, musician accepts/declines/
//   completes).
// - reviews/ are keyed by bookingId; only the organizer on that booking
//   may create the review, exactly once, and only after the booking is
//   marked completed.
//
// E-Cards (Phase 2, additive): ecards/{ecardId} and its guests/
// subcollection follow the same isOwner-style direct-field-comparison
// pattern as events/{eventId} — an organizer can only read/write
// E-Card data whose organizer_id matches their own uid, and creating
// an E-Card requires the referenced events/{eventId} to already be
// owned by that same uid. ecard_templates/ is public-read reference
// data, same treatment as skills/.
//
// Admin operations (managing skills/categories, blog content,
// moderating content, verifying users) can now be performed by any
// account with users/{uid}.user_type == 'admin', enforced via the
// isAdmin() lookup below. This is not spoofable client-side — it's a
// server-side rule evaluation reading the actual stored document, the
// same mechanism isOwner() and the review-eligibility check already
// rely on. There is still no client path to ever set user_type to
// 'admin' in the first place (see the users/{uid} update rule), so an
// account can only become an admin via the Firebase Console or Admin
// SDK, never through the app itself.
//
// Admin account moderation (deactivate/reactivate a musician or
// organizer): deliberately narrow. isAdmin() is allowed to update
// ONLY the `disabled` field on users/{uid} and musicians/{uid} —
// enforced via affectedKeys().hasOnly(['disabled']) — never full
// write access to someone else's profile. The account owner still
// controls every other field of their own document as before; they
// just can't touch `disabled` themselves (same locking pattern
// already used for user_type). Admin delete of users/{uid} and
// musicians/{uid} removes the Firestore profile only — it does NOT
// remove the underlying Firebase Auth credential, which only the
// Admin SDK (a Cloud Function) can do for an account that isn't your
// own. A deleted profile is functionally locked out of the app (no
// dashboard, not in any directory) even though the bare login
// credential technically still exists until that Cloud Function is
// deployed.
//
// disabled field default handling: any account that has never been
// deactivated has NO `disabled` field on its document at all —
// accessing a missing field directly (resource.data.disabled) throws
// an error in Firestore rules rather than returning false, which
// would incorrectly deny a normal user's own profile edit. Every
// comparison against `disabled` below uses .get('disabled', false)
// specifically to avoid that.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Checks the caller's own users/{uid} doc for user_type == 'admin'.
    // Used to gate the in-app blog management screens at the data
    // layer, mirroring the redirect guard already enforced client-side
    // in app_router.dart for /admin routes.
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.user_type == 'admin';
    }

    // Checks the caller's own users/{uid} doc for verified == true.
    // Used to gate event creation to verified organizers only (see
    // events/{eventId} create rule below).
    function isVerifiedOrganizer() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('verified', false) == true;
    }

    // ---------------- Users ----------------
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid)
        // A new account can never register itself as already verified
        // or disabled — both must start false, only an admin action
        // can change them afterward. Without this, someone calling
        // Firestore directly (bypassing the app's own UI, which never
        // sends true here) could self-verify right at signup.
        && request.resource.data.get('verified', false) == false
        && request.resource.data.get('disabled', false) == false;
      allow update: if (isOwner(uid)
          // user_type is set once at registration and never changed by
          // the client afterwards, to keep role-specific data consistent.
          && request.resource.data.user_type == resource.data.user_type
          // The owner can change anything about their own profile
          // except disabled/verified — only an admin may flip those.
          // Locking verified here is the actual enforcement of the
          // approval gate: without this, a user could just write
          // verified: true to their own document directly and skip
          // admin review entirely.
          && request.resource.data.get('disabled', false) == resource.data.get('disabled', false)
          && request.resource.data.get('verified', false) == resource.data.get('verified', false))
        || (isAdmin()
          // Admin's only allowed writes here are disabled/verified —
          // nothing else about another user's profile, ever.
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disabled', 'verified']));
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ---------------- Musicians ----------------
    match /musicians/{uid} {
      allow read: if true; // public directory — the browse query itself filters out disabled == true
      allow create: if isOwner(uid)
        && request.resource.data.get('verified', false) == false
        && request.resource.data.get('disabled', false) == false;
      allow delete: if isOwner(uid) || isAdmin();
      allow update: if (isOwner(uid)
          && request.resource.data.get('disabled', false) == resource.data.get('disabled', false)
          && request.resource.data.get('verified', false) == resource.data.get('verified', false))
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disabled', 'verified']));
    }

    // ---------------- Organizers ----------------
    match /organizers/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid);
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ---------------- Skills (admin-managed reference data) ----------------
    match /skills/{skillId} {
      allow read: if true;
      allow write: if false; // managed via Admin SDK / console only
    }

    // ---------------- Bookings ----------------
    match /bookings/{bookingId} {
      allow read: if isSignedIn() &&
        (resource.data.musician_id == request.auth.uid || resource.data.organizer_id == request.auth.uid);

      allow create: if isSignedIn() &&
        (request.resource.data.organizer_id == request.auth.uid || request.resource.data.musician_id == request.auth.uid) &&
        request.resource.data.created_by == request.auth.uid &&
        request.resource.data.status == 'pending';

      allow update: if isSignedIn() &&
        (resource.data.musician_id == request.auth.uid || resource.data.organizer_id == request.auth.uid) &&
        // Only status (and updated_at) may change after creation — the
        // parties can't rewrite event details after the fact.
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at', 'review_submitted']);

      allow delete: if false; // bookings are cancelled, not deleted, to preserve history
    }

    // ---------------- Reviews ----------------
    match /reviews/{bookingId} {
      allow read: if true; // public, shown on musician profiles

      allow create: if isSignedIn() &&
        request.resource.data.organizer_id == request.auth.uid &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        get(/databases/$(database)/documents/bookings/$(bookingId)).data.status == 'completed' &&
        get(/databases/$(database)/documents/bookings/$(bookingId)).data.organizer_id == request.auth.uid;

      allow update, delete: if false; // reviews are immutable once submitted
    }

    // ---------------- Events ----------------
    match /events/{eventId} {
      allow read: if true; // public listing

      allow create: if isSignedIn()
        && request.resource.data.organizer_id == request.auth.uid
        // Account-level approval gate: an organizer can log in and
        // see their dashboard while unverified, but cannot publish
        // events until an admin approves the account.
        && isVerifiedOrganizer();

      allow update: if isSignedIn() && (resource.data.organizer_id == request.auth.uid || isAdmin());

      allow delete: if isSignedIn() && (resource.data.organizer_id == request.auth.uid || isAdmin());
    }

    // ---------------- E-Cards (Phase 2 — additive; visibility + admin moderation added later) ----------------
    // Same ownership pattern as events/{eventId} above: direct field
    // comparison against request.auth.uid, no new role/claims
    // mechanism. ecards/{ecardId}.organizer_id is required to match
    // the referenced events/{eventId}.organizer_id at create time, so
    // an organizer can never attach an E-Card to someone else's event.
    //
    // visibility: 'private' (default) or 'public' — an organizer's own
    // opt-in choice (see Ecard model doc comment). A public E-Card is
    // readable by anyone, signed in or not, same treatment as
    // events/{eventId}'s public listing. Guests/ subcollection stays
    // owner-only regardless of visibility — a card being public never
    // exposes its guest list.
    match /ecard_templates/{templateId} {
      allow read: if true; // public reference data, like skills/
      allow write: if false; // managed via Admin SDK / console only
    }

    match /ecards/{ecardId} {
      allow read: if (isSignedIn() && resource.data.organizer_id == request.auth.uid)
        || isAdmin()
        || resource.data.visibility == 'public';

      allow create: if isSignedIn()
        && request.resource.data.organizer_id == request.auth.uid
        && get(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.organizer_id == request.auth.uid;

      allow update: if (isSignedIn() && resource.data.organizer_id == request.auth.uid) || isAdmin();
      allow delete: if (isSignedIn() && resource.data.organizer_id == request.auth.uid) || isAdmin();

      match /guests/{guestId} {
        allow read, write: if isSignedIn()
          && get(/databases/$(database)/documents/ecards/$(ecardId)).data.organizer_id == request.auth.uid;
      }
    }

    // ---------------- E-Card Requests (admin approval to create an E-Card) ----------------
    match /ecard_requests/{requestId} {
      allow read: if isSignedIn() &&
        (resource.data.organizer_id == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
        request.resource.data.organizer_id == request.auth.uid &&
        request.resource.data.status == 'pending';

      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'admin_reply', 'resolved_at', 'resolved_by']);

      allow delete: if false;
    }

    // ---------------- Messages (admin <-> musician/organizer) ----------------
    // One thread per user, doc id == their own uid, same pattern as
    // users/musicians/organizers themselves. Any admin may read/reply
    // to any thread (not assigned per-admin), matching how every
    // other admin-moderated collection in this file works.
    match /message_threads/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Either party can create/update the thread summary doc — the
      // first message from either side establishes it, and every
      // subsequent message updates last_message/unread flags. The
      // actual message content lives in the subcollection below,
      // this doc is only ever a summary/preview.
      allow create, update: if isOwner(uid) || isAdmin();
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isOwner(uid) || isAdmin();

        // A message's sender_id must be the actual caller, and
        // sender_role must truthfully reflect which side they're on
        // — a user can't post a message tagged as if it came from
        // admin, and vice versa.
        allow create: if (isOwner(uid)
              && request.resource.data.sender_id == request.auth.uid
              && request.resource.data.sender_role == 'user')
          || (isAdmin()
              && request.resource.data.sender_id == request.auth.uid
              && request.resource.data.sender_role == 'admin');

        // Only admin can ever touch a message after it's sent, and
        // only to toggle `liked` — the "reply or like" interaction
        // from the spec. Nobody can edit message text after sending,
        // on either side.
        allow update: if isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['liked']);

        allow delete: if false;
      }
    }

    // ---------------- Blog ----------------
    match /blogCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blogPosts/{postId} {
      allow read: if resource.data.is_published == true || isSignedIn();
      allow write: if isAdmin();
    }

    // ---------------- Notifications ----------------
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow update: if isSignedIn() && resource.data.user_id == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false; // written by Cloud Functions only
    }
  }
}
